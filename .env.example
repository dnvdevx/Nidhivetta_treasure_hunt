# Shared game-state database (REQUIRED on Vercel).
# Connecting Upstash Redis to the Vercel project sets these automatically.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token

# JWT secret for team member sessions. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Master organizer passwords (comma-separated). Overrides the defaults in server/scheduleData.js.
MASTER_ADMIN_PASSWORDS=change-me-1,change-me-2

# Optional station volunteer passcode overrides
# STATION_PASSCODE_HOT_N_COLD=
# STATION_PASSCODE_JIGSAW=
# STATION_PASSCODE_PHOTO_GAME=
# STATION_PASSCODE_MOVIE_GAME=
# STATION_PASSCODE_BOAT_GAME=
# STATION_PASSCODE_FINAL_GAME=

# Server Port (Local dev)
PORT=5000
